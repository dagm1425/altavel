# Copy this file to .env and fill in the values from your EmailJS dashboard (https://dashboard.emailjs.com).
# These are public identifiers, safe to use in browser code. The recipient address
# (dagmawinebeyu3@gmail.com) is set in the EmailJS template's "To Email" field, not here.

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Email Services > your service > Service ID
VITE_EMAILJS_SERVICE_ID=

# Email Templates > your template > Template ID
VITE_EMAILJS_TEMPLATE_ID=

# Public site URL, e.g. https://www.altavel.com. Set it once the real domain exists; the build
# uses it for canonical URLs, og:url, and sitemap.xml (they are skipped while it is empty).
VITE_SITE_URL=
